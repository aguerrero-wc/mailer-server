# Desarrollo: copiar a .env y completar las credenciales.
NODE_ENV=development
VERSION=latest
APP_PORT=3001
API_KEY_PRIVATE_ZONES=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Soporte <no-reply@miempresa.com>"

# Puertos publicados en el host. Dentro de Docker se usan postgres:5432 y redis:6379.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mailer_db
DB_USERNAME=postgres
DB_PASSWORD=securepass
REDIS_HOST=localhost
REDIS_PORT=6380

# Si desarrollo y producción comparten host, usar un proyecto distinto SOLO en desarrollo:
# COMPOSE_PROJECT_NAME=mailer-service-dev
