# Producción: copiar a .env.production y completar con los valores existentes en el servidor.
# No copiar credenciales de desarrollo ni cambiar DB_NAME, DB_USERNAME o DB_PASSWORD al migrar.
NODE_ENV=production
VERSION=latest
# Nginx es el único puerto publicado; Nest escucha internamente en app-prod:3000.
NGINX_HTTP_PORT=3001
# IP/CIDR del proxy que termina TLS (NPM). Por defecto solo se confía en loopback.
API_KEY_SECRET=
API_KEY_PRIVATE_ZONES=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Soporte <no-reply@miempresa.com>"

DB_NAME=mailer_db
DB_USERNAME=postgres
DB_PASSWORD=

# Si el despliegue anterior definía COMPOSE_PROJECT_NAME o usaba -p, conservar EXACTAMENTE ese valor.
# Si no, mantener el mismo directorio del proyecto y dejar esta variable sin definir.
# COMPOSE_PROJECT_NAME=
